# Application Environment
APP_ENV=development
COLLEGE_NAME=MNNIT Allahabad
FRONTEND_ORIGIN=http://localhost:5173

# Database Connection
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=network_portal

# Admin Credentials & Auth (Default admin password is 'admin123')
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=$2b$12$z11TCwrLVRnlzFvMTKV2suLuuSeDTrATQJN2.b0ZARDdcuzbnyyhm
JWT_SECRET=mnnit-network-portal-jwt-secret-key-32bytes-min
JWT_EXPIRE_HOURS=8

# Multi-Provider LLM Fallback Orchestration
LLM_PROVIDER_ORDER=gemini,openai,grok,anthropic,mock

# Provider API Keys
GEMINI_API_KEY=
OPENAI_API_KEY=
GROK_API_KEY=
LLM_API_KEY=  # Anthropic API Key

# Provider Model Definitions
GEMINI_MODEL=gemini-1.5-flash
OPENAI_MODEL=gpt-4o-mini
GROK_MODEL=grok-beta
LLM_MODEL_CHAT=claude-3-5-sonnet-20241022
LLM_MODEL_GUARD=claude-3-5-haiku-20241022

# Embeddings and Vector Store Paths
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHROMA_DIR=./data/chroma
UPLOAD_DIR=./data/uploads

# Policy Limits
MAX_CHAT_MESSAGES=10
MAX_UPLOAD_MB=10
