# Application Environment
APP_ENV=development
COLLEGE_NAME=MNNIT Allahabad
FRONTEND_ORIGIN=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:5173
APP_TIMEZONE=Asia/Kolkata

# Database Connection
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=network_portal

# Auth & JWT Security
JWT_SECRET=mnnit-network-portal-jwt-secret-key-32bytes-min
JWT_EXPIRE_HOURS=8
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15

# OTP Complaint Registration
ALLOWED_EMAIL_DOMAIN=mnnit.ac.in
OTP_SECRET=mnnit-otp-secret-key-32bytes-min
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=60
OTP_MAX_RESENDS=3
OTP_MAX_REQUESTS_PER_EMAIL_PER_HOUR=5

# Lifecycle & Confirmation Token Settings
AUTO_CLOSE_DAYS=3
AUTO_CLOSE_CHECK_MINUTES=30
ACTION_TOKEN_EXPIRY_DAYS=14

# Email & Outbox Settings
EMAIL_BACKEND=console # console | smtp
SMTP_HOST=localhost
SMTP_PORT=25
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=false
EMAIL_FROM=noreply@mnnit.ac.in
INCHARGE_CC_EMAILS= # comma-separated emails e.g. incharge@mnnit.ac.in

# Leaderboard Scoring Settings
SCORE_FORMULA=average # average | weighted
SCORE_PRIOR_MEAN=3.5
SCORE_PRIOR_COUNT=5

# Module 2 Agentic AI Settings
AGENT_ENABLED=true # Enable or disable all agentic workflows (true|false)
AGENT_ASSIGNMENT_MODE=auto # Technician assignment execution mode (auto|suggest|off)
AGENT_USE_LLM=true # Use LLM router for classification (true|false)
AGENT_LLM_REASON=true # Use LLM to rewrite assignment reasons into friendly text (true|false)
AGENT_CATEGORY_MIN_CONFIDENCE=0.75 # Confidence threshold to adopt AI category over student category
AGENT_SIMILAR_WINDOW_HOURS=6 # Time window in hours for open cluster fault matching
AGENT_PREVIOUS_FAULT_DAYS=90 # Time window in days for historical closed fault solutions
AGENT_HIGH_IMPACT_USERS=5 # Affected user count threshold to bump priority +1
AGENT_CRITICAL_IMPACT_USERS=20 # Affected user count threshold to set CRITICAL priority
AGENT_PRIORITY_LOCATIONS= # Comma-separated list of high priority location names
AGENT_STUCK_MINUTES=10 # Minutes before stuck SUBMITTED complaints fall back to rules
AGENT_SWEEP_MINUTES=5 # Minutes between background unassigned complaint assignment sweeps
AGENT_MAX_ATTEMPTS=3 # Max retry attempts for background agent jobs
AGENT_ASSIGNMENT_WEIGHTS= # Optional JSON string overriding candidate scoring weights
RAG_AUTO_INDEX_CLOSED=true # Automatically index eligible closed complaints into RAG (true|false)
RAG_INCLUDE_AUTO_CLOSED=false # Index auto-closed complaints without student response (true|false)
AGENT_USE_RAG_SIMILARITY=false # Enable RAG similarity search for similar faults (true|false)

# Multi-Provider LLM Fallback Orchestration
LLM_PROVIDER_ORDER=gemini,openai,grok,anthropic,mock

# Provider API Keys
GEMINI_API_KEY=
OPENAI_API_KEY=
GROK_API_KEY=
LLM_API_KEY= # Anthropic API Key

# Provider Model Definitions
GEMINI_MODEL=gemini-3.8-flash
OPENAI_MODEL=gpt-4o-mini
GROK_MODEL=grok-beta
LLM_MODEL_CHAT=claude-3-5-sonnet-20241022
LLM_MODEL_GUARD=claude-3-5-haiku-20241022

# Flow Trace Configuration
FLOW_TRACE=true # Set to false to disable end-to-end LLM flow tracing
FLOW_TRACE_SLOW_MS=3000 # Threshold in milliseconds to flag slow execution steps

# Embeddings and Vector Store Paths
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHROMA_DIR=./data/chroma
UPLOAD_DIR=./data/uploads

# Policy Limits
MAX_CHAT_MESSAGES=10
MAX_UPLOAD_MB=10
